# VitaCircle environment — copy to .env for local development.
# Never commit real secrets. Use a cloud secret manager in staging/production.
#
# Docker Compose overrides Mongo/Redis/AI URLs inside containers so services
# talk on the vitacircle network. Browser URLs stay on localhost below.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_URL=http://localhost:8000
PUBLIC_PORTFOLIO_DOMAIN=localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Host-side npm dev: use 127.0.0.1. Docker Compose sets mongo/redis/ai hostnames.
MONGODB_URI=mongodb://127.0.0.1:27017/vitacircle

# Redis (optional locally — API falls back to inline jobs)
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-dev-only
JWT_REFRESH_SECRET=change-me-refresh-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

# OAuth — leave client IDs empty to hide social sign-in buttons in the web app.
# Google Cloud Console: APIs & Services → Credentials → OAuth 2.0 Web client.
# Authorized redirect URI (local): http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# LinkedIn Developer Portal: create app, add redirect URL below.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:4000/auth/linkedin/callback

# Object storage — local disk by default; set S3_* to use S3/R2
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=vitacircle
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Stripe (Phase 2) — test mode keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_STUDIO=

# LLM (Python AI service)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=heuristic
AI_MODEL=gpt-4o-mini

# Email — local MailHog SMTP in development
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VitaCircle <noreply@vitacircle.local>

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Admin bootstrap (dev only)
BOOTSTRAP_ADMIN_EMAIL=admin@vitacircle.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin1!

# Feature
ENABLE_MALWARE_SCAN=false
ENABLE_COLLAB=true
